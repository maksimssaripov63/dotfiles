: 1790610300:0;cat << 'EOF' > ~/.local/bin/anuclipt\
#!/usr/bin/env bash\
\
# anuclipt - a simple clipboard manager for wayland\
# repo: ://github.com\
\
CACHE_DIR="$HOME/.cache/anuclipt"\
HISTORY_FILE="$CACHE_DIR/history"\
\
mkdir -p "$CACHE_DIR"\
touch "$HISTORY_FILE"\
\
store() {\
    local text\
    text=$(cat)\
    if [[ -n "$text" ]]; then\
        # Удалу�ем ду�бликату� и запису�ваем нову�у� строку� в нау�ало истории\
        local temp\
        temp=$(mktemp)\
        echo "$text" > "$temp"\
        cat "$HISTORY_FILE" | grep -v -F -x "$text" >> "$temp" 2>/dev/null || true\
        head -n 100 "$temp" > "$HISTORY_FILE"\
        rm -f "$temp"\
    fi\
}\
\
list() {\
    cat "$HISTORY_FILE"\
}\
\
decode() {\
    cat\
}\
\
case "$1" in\
    store)  store ;;\
    list)   list ;;\
    decode) decode ;;\
    *)      echo "Usage: $0 {store|list|decode}" ;;\
esac\
EOF\

: 1790610305:0;# 1. Ѓ�аем у�айлу� легитимну�е права на запу�ск\
chmod +x ~/.local/bin/anuclipt\
\
# 2. Ѓ�асилу�но гасим стару�е ослепу�ие проу�ессу�\
killall wl-paste 2>/dev/null\
\
# 3. Ѓ�апу�скаем у�исту�й, свежий у�онову�й поток слежениу� за бу�у�ером\
wl-paste --type text --watch /home/rdf-2041/.local/bin/anuclipt store &\

