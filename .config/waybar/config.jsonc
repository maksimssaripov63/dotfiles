{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "height": 20,

    // --- Распределение модулей по позициям ---
    "modules-left": [
        "custom/launcher",
        "custom/procs",
        "tray",
        "custom/spaces",
        "hyprland/workspaces",
        "custom/add_workspace",
        //"hyprland/window",
        "custom/usb"
    ],
 
    "modules-center": [
        "custom/mpris",
        "custom/uptime",
        "battery",
        "clock",
        "custom/calendar",
        "custom/language"
    ],
    
    "modules-right": [
        "cpu",
        "custom/gpu",
        "memory",
        "pulseaudio#output",
        //"custom/volume",
        "pulseaudio#microphone",
        "backlight",
        "bluetooth",
        "custom/power",
        ""
    ],

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}%",
        "format-charging": "{capacity}%",
        "format-plugged": "PLUG {capacity}%"
    },

    "clock": {
        "format": "  {:%H:%M:%S} ",
        "format-alt": "  {:%d-%m-%Y (%A)} ",
        "interval": 1,
        "on-click-right": "gnome-calendar",
        "on-click": "pkill yad || yad --calendar --width=250 --height=200 --undecorated --fixed --posx=830 --posy=45 --close-on-unfocus",
        "tooltip": true,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },


  "custom/calendar": {
    "format": "",
    "on-click": "lvsk-calendar-launcher",
    "tooltip-format": "Click to open calendar"
  },


    "custom/language": {
        // Скрипт мгновенно вытаскивает активный язык системы, берет первые 2 буквы и делает их заглавными (EN/RU)
        "exec": "hyprctl devices -j | jq -r '.keyboards[] | select(.main == true) | .active_keymap' | cut -c1-2 | tr '[:lower:]' '[:upper:]'",
        "interval": 0,
        "format": "   {}",
        "tooltip": false,
        "on-click-right": "echo 'English (EN)\nРусский (RU)' | wofi --dmenu --prompt 'Выберите язык / Select language' | grep -q 'Русский' && hyprctl switchxkblayout all 1 || hyprctl switchxkblayout all 0",
        "on-click": "hyprctl switchxkblayout all next"
    },


    // --- Настройки модулей СПРАВА ---
    "cpu": {
        "interval": 2,
        "format": "  CPU:{usage}%",
        "on-click": "tmog-task-manager"
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | awk '{print \"  GPU:\" $1 \"%\"}'",
        "interval": 2,
        "format": "{}",
        "on-click": "tmog-task-manager"
    },

    "memory": {
        "interval": 2,
        "format": "  RAM:{used:0.1f}G/{total:0.1f}G",
        "on-click": "tmog-task-manager"
    },

    // --- УПРАВЛЕНИЕ ВЫВОДОМ ЗВУКА (ДИНАМИКИ/НАУШНИКИ) ---
    "pulseaudio#output": {
        "format": " OUT: {volume}%",
        "format-muted": " OUT: Выкл",
        "on-click": "pavucontrol",
        // Жестко выставляем шаг в 5% на внутреннем уровне ядра Waybar
        "scroll-step": 5,
        "max-volume": 100,
        // КРИТИЧНО: Заставляет панель склеивать мелкие тики мыши обратно в один четкий шаг
        "smooth-scrolling-threshold": 1.0,
        "tooltip": false
    },


    // --- УПРАВЛЕНИЕ МИКРОФОНОМ (НЕЗАВИСИМОЕ) ---
    "pulseaudio#microphone": {
        "format": "  INP: {format_source}",
        "format-source": "Вкл",
        "format-source-muted": "Выкл",
        "on-click": "pavucontrol"
    },

"bluetooth": {
    "interval": 1,
    "format": "  Bluetooth ",
    "format-disabled": "    BT Выкл ",
    "format-connected": "    BT: {num_connections} ",
    "on-click": "blueman-manager",
    "on-click-right": "bash -c 'rfkill unblock bluetooth; if bluetoothctl show | grep -q \"Powered: yes\"; then bluetoothctl power off; else bluetoothctl power on; fi; pkill -SIGRTMIN+9 waybar'"
},



    //--- КНОПКА ПИТАНИЯ (БРОНЕБОЙНАЯ КОМАНДА ВЫХОДА) ---
    "custom/power": {
        "format": "⏻ ",
        "on-click": "~/.config/waybar/scripts/powermenu.sh",
        "tooltip": false
    },

    "custom/launcher": {
        "interval": 1,
        "format": " 󰣇 ",           // Стильная иконка меню приложений
        //"tooltip": true, 
        "exec": "hyprctl activewindow -j | jq -r '.title' 2>/dev/null",
        "on-click": "wofi --show drun --allow-images --insensitive",
        "tooltip-format": "<span font='9' rise='-4444'>{}</span>"
    },

    "custom/add_workspace": {
        "format": " + ", 
        "on-click": "hl.dsp.focus({ workspace = \"+1\" })",
        "tooltip": false
    },

    "backlight": {
        "device": "intel_backlight", // или amdgpu_bl0 в зависимости от процессора
        "format": "  LIGHT:{percent}%",
        "scroll-step": 5,
         //При клике открывается встроенный ползунок яркости через системный интерфейс gnome/mate (если установлен)
        // либо графическая панель управления утилиты blugon / brightness-controller
        "on-click": "brightness-controller || generic-bl-slider || nwg-displays" 
    },

    "custom/volume": {
        "exec": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print sprintf(\"%.0f\", $2 * 100)}'",
        "interval": 0,
        "format": " OUT: {}%",
        "on-click": "pavucontrol",
        // Умный скролл: высчитывает текущую громкость, округляет до кратного 5 и жестко ставит (+5% / -5%)
        "on-scroll-up": "sh -c 'V=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk \"{print int(\\$2*100)}\"); NEW=$(( ((V + 4) / 5) * 5 + 5 )); if [ $NEW -le 100 ]; then wpctl set-volume @DEFAULT_AUDIO_SINK@ ${NEW}%; fi'",
        "on-scroll-down": "sh -c 'V=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk \"{print int(\\$2*100)}\"); NEW=$(( ((V - 1) / 5) * 5 - 5 )); if [ $NEW -ge 0 ]; then wpctl set-volume @DEFAULT_AUDIO_SINK@ ${NEW}%; else wpctl set-volume @DEFAULT_AUDIO_SINK@ 0%; fi'",
        "tooltip": false
    },

    "custom/usb": {
        "exec": "paths=($(findmnt -ln -o TARGET | grep '^/run/media/rdf-2041/')); count=${#paths[@]}; if [ $count -eq 0 ]; then echo \"{\\\"text\\\": \\\"\\\"}\"; exit 0; fi; idx=$(cat /tmp/active_usb_idx 2>/dev/null || echo 0); if [ $idx -ge $count ] || [ $idx -lt 0 ]; then idx=0; echo 0 > /tmp/active_usb_idx; fi; active_path=${paths[$idx]}; active_name=$(basename \"$active_path\"); echo \"{\\\"text\\\": \\\"  $active_name ($((idx+1))/$count)\\\", \\\"tooltip\\\": \\\"Путь: $active_path\\\"}\"",
        "interval": 1,

        "format": "{}", 
        "return-type": "json",

        "on-click": "paths=($(findmnt -ln -o TARGET | grep '^/run/media/rdf-2041/')); idx=$(cat /tmp/active_usb_idx 2>/dev/null || echo 0); active_path=${paths[$idx]}; if [ -d \"$active_path\" ]; then dolphin \"$active_path\"; fi",
        "on-click-right": "paths=($(findmnt -ln -o TARGET | grep '^/run/media/rdf-2041/')); idx=$(cat /tmp/active_usb_idx 2>/dev/null || echo 0); active_path=${paths[$idx]}; active_name=$(basename \"$active_path\"); if [ -n \"$active_path\" ]; then pkill -f \"dolphin $active_path\"; udiskie-umount \"$active_path\" && notify-send \"USB-накопитель\" \"Диск $active_name успешно извлечен!\"; echo 0 > /tmp/active_usb_idx; fi",
        "on-scroll-up": "paths=($(findmnt -ln -o TARGET | grep '^/run/media/rdf-2041/')); count=${#paths[@]}; if [ $count -gt 1 ]; then idx=$(cat /tmp/active_usb_idx 2>/dev/null || echo 0); idx=$(( (idx + 1) % count )); echo $idx > /tmp/active_usb_idx; pkill -RTMIN+8 waybar; fi",
        "on-scroll-down": "paths=($(findmnt -ln -o TARGET | grep '^/run/media/rdf-2041/')); count=${#paths[@]}; if [ $count -gt 1 ]; then idx=$(cat /tmp/active_usb_idx 2>/dev/null || echo 0); idx=$(( (idx - 1 + count) % count )); echo $idx > /tmp/active_usb_idx; pkill -RTMIN+8 waybar; fi",
        "signal": 8
    },


    "custom/uptime": {
        "exec": "awk '{print int($1/3600)\":\"int(($1%3600)/60)\":\"int($1%60)}' /proc/uptime | awk -F: '{printf \"%02d:%02d:%02d\\n\", $1, $2, $3}'",
        "interval": 1,
        "format": " {}  ",
        "tooltip": false
    },

    "mpris": {
      "format": "{player_icon} {dynamic}   ",
      "format-paused": "{status_icon} <i>{dynamic}</i>   ",
      "dynamic-order": ["title", "artist"],
      "dynamic-len": 40, // Максимальная длина текста, чтобы панель не «разъезжалась»
      "player-icons": {
        "default": "⏸",
        "spotify": "",
        "mpv": "🎵",
        "firefox": ""
      },
      "status-icons": {
        "paused": "▶"
      },
      "ignored-players": [""], // Игнорировать определенные плееры, если нужно

      // 🚀 ЛЕВЫЙ КЛИК: Вызывает сочное графическое меню Wofi со списком плееров и управлением
        "on-click-backward": "playerctl --list-all | xargs -I {} sh -c 'status=$(playerctl --player={} status 2>/dev/null); meta=$(playerctl --player={} metadata --format \"{{title}} - {{artist}}\" 2>/dev/null); echo \"{}: [$status] $meta\"' | wofi --dmenu --prompt 'Управление медиаплеерами' | awk -F: '{print $1}' | xargs -I {} playerctl --player={} play-pause",

        // 🚀 СКРОЛЛ ВВЕРХ (mUp): Мгновенно включает СЛЕДУЮЩИЙ трек на активном плеере!
        "on-click-right": "playerctl next",

        // 🚀 СКРОЛЛ ВНИЗ (mDown): Мгновенно включает ПРЕДЫДУЩИЙ трек на активном плеере!
        "on-click-middle": "playerctl previous",

        // 🚀 ХАК ДЛЯ ПЕРЕКЛЮЧЕНИЯ ПЛЕЕРОВ: Вешаем на правый клик смену самого плеера (например, со Spotify на Firefox)
        "on-click": "playerctl play-pause",

        // 🚀 СКРОЛЛ ВВЕРХ: Циклически переключает фокус на СЛЕДУЮЩИЙ запущенный плеер (Spotify -> Firefox)!
        "on-scroll-up": "players=($(playerctl --list-all 2>/dev/null)); count=${#players[@]}; if [ $count -gt 1 ]; then idx=$(cat /tmp/active_player_idx 2>/dev/null || echo 0); idx=$(( (idx + 1) % count )); echo $idx > /tmp/active_player_idx; playerctl switch-to ${players[$idx]}; fi",

        // 🚀 СКРОЛЛ ВНИЗ: Циклически переключает фокус на ПРЕДЫДУЩИЙ запущенный плеер!
        "on-scroll-down": "players=($(playerctl --list-all 2>/dev/null)); count=${#players[@]}; if [ $count -gt 1 ]; then idx=$(cat /tmp/active_player_idx 2>/dev/null || echo 0); idx=$(( (idx - 1 + count) %  count )); echo $idx > /tmp/active_usb_idx; playerctl switch-to ${players[$idx]}; fi"
    },


"custom/mpris": {
    // 🚀 EXEC: Сохраняет полное название для тултипа, а для панели ювелирно клеит троеточие "..." при переполнении!
    "exec": "players=($(playerctl --list-all 2>/dev/null)); count=${#players[@]}; if [ $count -eq 0 ]; then echo \"{\\\"text\\\": \\\"\\\"}\"; exit 0; fi; idx=$(cat /tmp/active_player_idx 2>/dev/null || echo 0); if [ $idx -ge $count ] || [ $idx -lt 0 ]; then idx=0; echo 0 > /tmp/active_player_idx; fi; active_player=${players[$idx]}; status=$(playerctl -p \"$active_player\" status 2>/dev/null); name_lower=$(echo \"$active_player\" | tr '[:upper:]' '[:lower:]'); text=$(playerctl -p \"$active_player\" metadata --format '{{title}} - {{artist}}' 2>/dev/null | sed 's/\"/\\\\\"/g'); if [ -z \"$text\" ] || [ \"$text\" = \" - \" ]; then text=$(playerctl -p \"$active_player\" metadata --format '{{xesam:title}}' 2>/dev/null | sed 's/\"/\\\\\"/g'); fi; if [ ${#text} -gt 40 ]; then text_short=$(echo \"$text\" | cut -c1-37)\"...\"; else text_short=\"$text\"; fi; if [ \"$status\" = \"Paused\" ]; then icon=\"▶ \"; else if [[ \"$name_lower\" == *spotify* ]]; then icon=\" \"; elif [[ \"$name_lower\" == *firefox* ]] || [[ \"$name_lower\" == *mozilla* ]]; then icon=\" \"; elif [[ \"$name_lower\" == *vlc* ]]; then icon=\"󰕼 \"; else icon=\"🎵 \"; fi; fi; pos_raw=$(playerctl -p \"$active_player\" position 2>/dev/null || echo 0); pos_sec=${pos_raw%%.*}; len_raw=$(playerctl -p \"$active_player\" metadata mpris:length 2>/dev/null || echo 0); len_sec=$((len_raw / 1000000)); if [ $len_sec -gt 0 ]; then time_str=$(printf \"[%02d:%02d / %02d:%02d]\" $((pos_sec / 60)) $((pos_sec % 60)) $((len_sec / 60)) $((len_sec % 60))); else time_str=$(printf \"[%02d:%02d]\" $((pos_sec / 60)) $((pos_sec % 60))); fi; echo \"{\\\"text\\\": \\\"$icon $text_short $time_str ($((idx+1))/$count)\\\", \\\"tooltip\\\": \\\"Плеер: $active_player\\\\nНазвание: $text\\\\nВремя: $time_str\\\"}\"",
    "interval": 1,
    "return-type": "json",
    "format": "{}",

    "on-click": "players=($(playerctl --list-all 2>/dev/null)); idx=$(cat /tmp/active_player_idx 2>/dev/null || echo 0); active_player=${players[$idx]}; if [ -n \"$active_player\" ]; then playerctl -p \"$active_player\" play-pause; fi",
    "on-click-right": "players=($(playerctl --list-all 2>/dev/null)); idx=$(cat /tmp/active_player_idx 2>/dev/null || echo 0); active_player=${players[$idx]}; if [ -n \"$active_player\" ]; then playerctl -p \"$active_player\" next; fi",
    "on-click-middle": "players=($(playerctl --list-all 2>/dev/null)); idx=$(cat /tmp/active_player_idx 2>/dev/null || echo 0); active_player=${players[$idx]}; if [ -n \"$active_player\" ]; then playerctl -p \"$active_player\" previous; fi",
    "on-scroll-up": "players=($(playerctl --list-all 2>/dev/null)); count=${#players[@]}; if [ $count -gt 1 ]; then idx=$(cat /tmp/active_player_idx 2>/dev/null || echo 0); idx=$(( (idx + 1) % count )); echo $idx > /tmp/active_player_idx; pkill -RTMIN+9 waybar; fi",
    "on-scroll-down": "players=($(playerctl --list-all 2>/dev/null)); count=${#players[@]}; if [ $count -gt 1 ]; then idx=$(cat /tmp/active_player_idx 2>/dev/null || echo 0); idx=$(( (idx - 1 + count) % count )); echo $idx > /tmp/active_player_idx; pkill -RTMIN+9 waybar; fi",
    "signal": 9
},



  "custom/procs": {
    "format": "   ", // Иконка меню (нужен Nerd Font). Можно заменить на другую, например "" или "⚙"
    "tooltip": true,
    "tooltip-format": "Диспетчер процессов",
    "on-click": "~/dotfiles/.config/waybar/scripts/process_menu.sh",
    "on-click": "kitty btop",
    "interval": "once"
},

  "custom/spaces": {
    "format": " "
  },

  "hyprland/window": {
    //"format": "{}"   // <--- это значение по умолчанию
    "format": "<span font='9' rise='-4444'>{}</span>"
  }


}

