# Шрифты
font-family = "JetBrainsMono Nerd Font"
font-size = 11

# Прозрачность окна и размытие фона
background-opacity = 0.2
background-blur = true

# Отступы внутри терминала
window-padding-x = 12
window-padding-y = 12
window-decoration = false

# --- Кастомная палитра цветов (Неоновый Темный) ---
background = #1a1b26
foreground = #a9b1d6
cursor-color = #c0caf5

# Стандартные цвета терминала
playlist = #15161e
color-0 = #414868
color-1 = #f7768e
color-2 = #73daca
color-3 = #e0af68
color-4 = #7aa2f7
color-5 = #bb9af7
color-6 = #7dcfff
color-7 = #c0caf5

# Яркие цвета (для папок, Git и вывода команд)
color-8 = #414868
color-9 = #f7768e
color-10 = #73daca
color-11 = #e0af68
color-12 = #7aa2f7
color-13 = #bb9af7
color-14 = #7dcfff
color-15 = #c0caf5

