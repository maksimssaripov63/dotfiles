# Шрифты
font-family = "JetBrainsMono Nerd Font"
font-size = 11

# Прозрачность окна и размытие фона
background-opacity = 0.7
background-blur = true

# Отступы внутри терминала
window-padding-x = 12
window-padding-y = 12
window-decoration = false

# --- Кастомная палитра цветов (Неоновый Темный) ---
background = #1a1b26
foreground = #a9b1d6
cursor-color = #c0caf5

# Стандартные цвета терминала
palette = 0 = #414868
palette = 1 = #ff0000
palette = 2 = #00ff00
palette = 3 = #00f0f1
palette = 4 = #7aa2f7
palette = 5 = #bb9af7
palette = 6 = #7dcfff
palette = 7 = #c0caf5

# Яркие цвета (для папок, Git и вывода команд)
palette = 8 = #414868
palette = 9 = #f7768e
palette = 10 = #73daca
palette = 11 = #e0af68
palette = 12 = #7aa2f7
palette = 13 = #bb9af7
palette = 14 = #7dcfff
palette = 15 = #c0caf5

