# font_family Sergamon
font_size   10

background_opacity 0.9

cursor_shape beam
cursor_trail 1

disable_ligatures never

# BEGIN_KITTY_FONTS
font_family      family="JetBrains Mono"
bold_font        auto
italic_font      auto
bold_italic_font family='JetBrains Mono' style='Bold Italic'
# END_KITTY_FONTS
